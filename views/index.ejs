<%- include('partials/header', { title: 'Studio Master Matrix' }) %>

<!-- Master Telemetry Banner -->
<%- include('partials/telemetry', { telemetry: typeof telemetry !== 'undefined' ? telemetry : undefined }) %>

<%
  // Resolves the 'projects' array sent from your Express route
  const list = (typeof projects !== 'undefined' && Array.isArray(projects)) ? projects : [];
  
  // Calculate status counts automatically from the list
  const totalCount = list.length;
  const inProgressCount = list.filter(p => (p.status || '').toLowerCase() === 'in progress').length;
  const inReviewCount = list.filter(p => (p.status || '').toLowerCase() === 'in review').length;
  const completedCount = list.filter(p => (p.status || '').toLowerCase() === 'completed').length;
  const delayedCount = list.filter(p => (p.status || '').toLowerCase() === 'delayed').length;
%>

<!-- Interactive Matrix Toolbar: Filter Pills & Search -->
<section class="matrix-toolbar">
  <div class="filter-pills-group" role="tablist" aria-label="Status Filters">
    <button class="filter-pill-btn active" data-filter="all" type="button">
      <span>All Dossiers</span>
      <span class="filter-count" id="activeFilterCount"><%= totalCount %></span>
    </button>
    <button class="filter-pill-btn" data-filter="in progress" type="button">
      <span style="color: #60A5FA;">&#x25CF;</span>
      <span>In Progress</span>
      <span class="filter-count"><%= inProgressCount %></span>
    </button>
    <button class="filter-pill-btn" data-filter="in review" type="button">
      <span style="color: #FBBF24;">&#x25CF;</span>
      <span>In Review</span>
      <span class="filter-count"><%= inReviewCount %></span>
    </button>
    <button class="filter-pill-btn" data-filter="completed" type="button">
      <span style="color: #34D399;">&#x25CF;</span>
      <span>Completed</span>
      <span class="filter-count"><%= completedCount %></span>
    </button>
    <button class="filter-pill-btn" data-filter="delayed" type="button">
      <span style="color: #F87171;">&#x25CF;</span>
      <span>Delayed</span>
      <span class="filter-count"><%= delayedCount %></span>
    </button>
  </div>

  <div class="search-wrapper">
    <input 
      type="text" 
      id="projectSearch" 
      class="search-input" 
      placeholder="Search clients, titles, tags..." 
      aria-label="Filter Dossiers"
    >
    <span class="search-kbd-hint">/</span>
  </div>
</section>

<!-- Project Matrix Responsive Grid -->
<section class="projects-grid" id="projectMatrixContainer">
  <% list.forEach(function(item) { %>
    <%- include('partials/project-card', { project: item }) %>
  <% }); %>
</section>

<!-- High-Impact Architectural Empty State -->
<section class="empty-state" id="matrixEmptyState" style="<%= list.length === 0 ? 'display: block;' : 'display: none;' %>">
  <div class="empty-state-kicker">// ARCHIVE EMPTY</div>
  <h3 class="empty-state-title">No Studio Dossiers Found</h3>
  <p class="empty-state-desc">
    There are currently no active projects matching this filter query. Initialize a new studio commission below.
  </p>
  <a href="/projects/new" class="btn btn-primary">
    <span>+ Initialize New Dossier</span>
  </a>
</section>

<%- include('partials/footer') %>
