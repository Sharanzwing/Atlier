<%
  const isEdit = typeof project !== 'undefined' && project && project.id;
  const p = isEdit ? project : {
    clientName: '',
    projectTitle: '',
    category: 'Full-Stack Development',
    status: 'In Progress',
    budget: '',
    currency: 'USD',
    amountPaid: 0,
    deadline: '',
    milestones: []
  };

  const formAction = isEdit ? `/projects/${p.id}?_method=PATCH` : '/projects';
  const pageTitle = isEdit ? `Edit Dossier: ${p.projectTitle}` : 'Initialize New Studio Dossier';
%>

<%- include('partials/header', { title: pageTitle }) %>

<div class="form-shell">
  <!-- Form Header -->
  <div class="form-shell-header">
    <nav class="breadcrumbs" style="margin-bottom: var(--space-xs);" aria-label="Breadcrumb">
      <a href="/">Studio Matrix</a>
      <span>/</span>
      <span><%= isEdit ? 'Edit Dossier' : 'New Dossier' %></span>
    </nav>
    <h1 style="font-size: 1.8rem;"><%= isEdit ? 'Update Project Commission' : 'Initialize Studio Commission' %></h1>
    <p style="font-size: 0.85rem; margin-top: 4px;">
      <%= isEdit ? 'Refine budget, deliverables, and operational phase.' : 'Register a bespoke client engagement into Atelier Studio OS.' %>
    </p>
  </div>

  <form action="<%= formAction %>" method="POST">
    <!-- Row 1: Client Name & Project Title -->
    <div class="form-grid-2">
      <div class="form-group">
        <label for="clientName" class="form-label">Client / Entity Name <span class="req">*</span></label>
        <input 
          type="text" 
          id="clientName" 
          name="clientName" 
          class="form-control" 
          placeholder="e.g. Aetheric Sound Labs" 
          value="<%= p.clientName %>" 
          required
        >
        <span class="form-hint">Initials will be auto-generated for the monogram avatar.</span>
      </div>

      <div class="form-group">
        <label for="projectTitle" class="form-label">Project Title / Scope <span class="req">*</span></label>
        <input 
          type="text" 
          id="projectTitle" 
          name="projectTitle" 
          class="form-control" 
          placeholder="e.g. Next-Gen Web Audio Synthesis Platform" 
          value="<%= p.projectTitle %>" 
          required
        >
      </div>
    </div>

    <!-- Row 2: Category & Status -->
    <div class="form-grid-2">
      <div class="form-group">
        <label for="category" class="form-label">Discipline / Category <span class="req">*</span></label>
        <select id="category" name="category" class="form-control" required>
          <option value="Full-Stack Development" <%= p.category === 'Full-Stack Development' ? 'selected' : '' %>>Full-Stack Development</option>
          <option value="Interface Engineering" <%= p.category === 'Interface Engineering' ? 'selected' : '' %>>Interface Engineering</option>
          <option value="Creative Direction" <%= p.category === 'Creative Direction' ? 'selected' : '' %>>Creative Direction</option>
          <option value="Brand Identity" <%= p.category === 'Brand Identity' ? 'selected' : '' %>>Brand Identity</option>
          <option value="Architectural Architecture" <%= p.category === 'Architectural Architecture' ? 'selected' : '' %>>Architectural Architecture</option>
        </select>
      </div>

      <div class="form-group">
        <label for="status" class="form-label">Commission Status <span class="req">*</span></label>
        <select id="status" name="status" class="form-control" required>
          <option value="In Progress" <%= p.status === 'In Progress' ? 'selected' : '' %>>In Progress</option>
          <option value="In Review" <%= p.status === 'In Review' ? 'selected' : '' %>>In Review</option>
          <option value="Completed" <%= p.status === 'Completed' ? 'selected' : '' %>>Completed</option>
          <option value="Delayed" <%= p.status === 'Delayed' ? 'selected' : '' %>>Delayed</option>
        </select>
      </div>
    </div>

    <!-- Row 3: Financials (Budget, Currency, Amount Paid) -->
    <div class="form-grid-2">
      <div class="form-group">
        <label for="budget" class="form-label">Contract Budget Total <span class="req">*</span></label>
        <input 
          type="number" 
          id="budget" 
          name="budget" 
          class="form-control mono-num" 
          placeholder="18500" 
          step="any" 
          value="<%= p.budget %>" 
          required
        >
      </div>

      <div class="form-group">
        <label for="currency" class="form-label">Settlement Currency <span class="req">*</span></label>
        <select id="currency" name="currency" class="form-control" required>
          <option value="USD" <%= p.currency === 'USD' ? 'selected' : '' %>>USD ($ - United States Dollar)</option>
          <option value="EUR" <%= p.currency === 'EUR' ? 'selected' : '' %>>EUR (€ - Euro)</option>
          <option value="GBP" <%= p.currency === 'GBP' ? 'selected' : '' %>>GBP (£ - British Pound)</option>
          <option value="INR" <%= p.currency === 'INR' ? 'selected' : '' %>>INR (₹ - Indian Rupee)</option>
        </select>
      </div>
    </div>

    <!-- Row 4: Amount Paid & Deadline -->
    <div class="form-grid-2">
      <div class="form-group">
        <label for="amountPaid" class="form-label">Deposit / Amount Received</label>
        <input 
          type="number" 
          id="amountPaid" 
          name="amountPaid" 
          class="form-control mono-num" 
          placeholder="0" 
          step="any" 
          value="<%= p.amountPaid || 0 %>"
        >
        <span class="form-hint">Unbilled balance will calculate automatically.</span>
      </div>

      <div class="form-group">
        <label for="deadline" class="form-label">Target Completion Date</label>
        <input 
          type="date" 
          id="deadline" 
          name="deadline" 
          class="form-control mono-num" 
          value="<%= p.deadline %>"
        >
      </div>
    </div>

    <!-- Row 5: Initial Deliverables / Milestones -->
    <div class="form-group">
      <label for="milestonesRaw" class="form-label">Key Milestones (One per line)</label>
      <textarea 
        id="milestonesRaw" 
        name="milestonesRaw" 
        class="form-control" 
        rows="4" 
        placeholder="Phase 1: Discovery & Architecture&#10;Phase 2: Core Engineering & Staging&#10;Phase 3: Production Release"
      ><%= (p.milestones && p.milestones.length) ? p.milestones.map(m => m.title).join('\n') : '' %></textarea>
      <span class="form-hint">Enter individual project milestones separated by line breaks.</span>
    </div>

    <!-- Actions Bar -->
    <div class="form-actions-bar">
      <a href="<%= isEdit ? `/projects/${p.id}` : '/' %>" class="btn btn-secondary">
        Cancel
      </a>
      <button type="submit" class="btn btn-primary">
        <span><%= isEdit ? 'Save Changes' : 'Create Studio Dossier' %></span>
      </button>
    </div>
  </form>
</div>

<%- include('partials/footer') %>
